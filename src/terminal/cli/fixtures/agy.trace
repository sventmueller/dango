# session sets neither. The spinner frames on its screen are a stand-in.
0 programs agy
0 out "\e[?25l\e[2J\e[H Antigravity CLI 1.5.3\r\n\r\n ▸ \e[?25h"
500 programs agy language_server_macos_arm
